#!/usr/bin/make -f
# No third-party crates, so the build needs no network and no vendoring.
export CARGO_HOME := $(CURDIR)/debian/cargo_home
export CARGO_TARGET_DIR := $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --offline

override_dh_auto_test:
	cargo test --release --locked --offline

override_dh_auto_install:
	install -D -m755 target/release/motd-forge debian/motd-forge/usr/bin/motd-forge
	install -D -m755 packaging/50-motd-forge debian/motd-forge/etc/update-motd.d/50-motd-forge
	install -D -m644 packaging/config.toml debian/motd-forge/etc/motd-forge/config.toml

override_dh_installsystemd:
	dh_installsystemd --name=motd-forge-refresh motd-forge-refresh.timer

override_dh_auto_clean:
	rm -rf target debian/cargo_home
